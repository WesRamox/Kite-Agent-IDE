# Copie para .env (fica fora do git). Variáveis passadas na linha de comando vencem este arquivo.
# Em `pnpm dev` vale o .env da pasta do projeto; no app instalado, o .env da pasta de perfil
# (Linux: ~/.config/Kite/.env, macOS: ~/Library/Application Support/Kite/.env,
# Windows: %APPDATA%\Kite\.env).

# Client ID do OAuth App do GitHub, com Device Flow ligado (veja o README).
GITHUB_CLIENT_ID=

# GitHub Enterprise (opcional)
# GITHUB_API_URL=https://api.github.com
# GITHUB_OAUTH_URL=https://github.com
# GITHUB_HOST=github.com

# Libera o DevTools em `pnpm dev` (ignorado no app empacotado)
# KITE_DEVTOOLS=1
